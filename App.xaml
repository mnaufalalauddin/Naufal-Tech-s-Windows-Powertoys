<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Naufal_Windows_Tech_s_Powertoys.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Naufal_Windows_Tech_s_Powertoys">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="NeutralButtonBackgroundBrush" Color="#EEF3F9"/>
                    <SolidColorBrush x:Key="NeutralButtonForegroundBrush" Color="#0B1520"/>
                    <SolidColorBrush x:Key="NeutralButtonBorderBrush" Color="#BBC7D5"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="NeutralButtonBackgroundBrush" Color="#213043"/>
                    <SolidColorBrush x:Key="NeutralButtonForegroundBrush" Color="#F3F6FA"/>
                    <SolidColorBrush x:Key="NeutralButtonBorderBrush" Color="#45566E"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="NeutralButtonBackgroundBrush" Color="#EEF3F9"/>
                    <SolidColorBrush x:Key="NeutralButtonForegroundBrush" Color="#0B1520"/>
                    <SolidColorBrush x:Key="NeutralButtonBorderBrush" Color="#BBC7D5"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Shared flat, bordered reference buttons. Keep a canonical light
                 palette here: UiDisplaySettings maps it to Dark from a stable
                 baseline, including buttons created while Dark is active. -->
            <Style x:Key="ReferenceButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="#EEF3F9"/>
                <Setter Property="Foreground" Value="#0B1520"/>
                <Setter Property="BorderBrush" Value="#BBC7D5"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="0"/>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource ReferenceButtonStyle}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
