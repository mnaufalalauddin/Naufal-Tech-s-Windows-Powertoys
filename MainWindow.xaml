<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Naufal_Windows_Tech_s_Powertoys.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Naufal_Windows_Tech_s_Powertoys"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Naufal Tech's Windows Powertoys">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout" Background="#F4F7FC" RequestedTheme="Light">
        <Grid.Resources>
            <Style x:Key="PanelBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="#F9FBFE"/>
                <Setter Property="BorderBrush" Value="#7F8C9D"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="0"/>
            </Style>

            <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource ReferenceButtonStyle}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="PrimaryToolButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
                <Setter Property="Background" Value="#2E66E5"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#2E66E5"/>
            </Style>

            <Style x:Key="DangerToolButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
                <Setter Property="Background" Value="#B91C23"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#B91C23"/>
            </Style>

            <Style x:Key="SuccessToolButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
                <Setter Property="Background" Value="#16833A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#16833A"/>
            </Style>

            <Style x:Key="WarningToolButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
                <Setter Property="Background" Value="#BE5705"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#BE5705"/>
            </Style>

            <Style x:Key="MetricCardStyle" TargetType="Border">
                <Setter Property="Background" Value="#EDF2F8"/>
                <Setter Property="BorderBrush" Value="#7F8C9D"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="MinHeight" Value="58"/>
                <Setter Property="CornerRadius" Value="0"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- APPLICATION HEADER -->
        <Border Grid.Row="0" MinHeight="86" Background="#F9FBFE" BorderBrush="#D2DAE5" BorderThickness="0,0,0,1">
            <Grid>
                <Border Width="6" HorizontalAlignment="Left" Background="#2E66E5"/>

                <Grid x:Name="HeaderLayout" Margin="24,10,20,10" SizeChanged="HeaderLayout_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="HeaderClock" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2" Margin="0,0,20,0">
                        <TextBlock x:Name="ClockText" Text="00:00:00" FontSize="25" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DateText" Text="Sunday, 30 August 2026" FontSize="11"
                               Foreground="#34455C" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SessionText" Text="Time spent 00:00:00" FontSize="11"
                               Foreground="#1B4D91" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid x:Name="HeaderSettings" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" ColumnSpacing="8" RowSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="LanguageLabel" Grid.Column="0" Text="Languages" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <ComboBox x:Name="LanguageComboBox" Grid.Row="1" Grid.Column="0" Width="160" MinWidth="0" Height="32"
                                      SelectionChanged="LanguageComboBox_SelectionChanged"/>
                            <Button x:Name="ThemeButton" Grid.Row="1" Grid.Column="1" Content="☀" Width="38" Height="32" MinHeight="32" CornerRadius="0"
                                    Click="ThemeButton_Click" AutomationProperties.Name="Toggle light or dark mode"/>
                            <Button x:Name="TextScaleButton" Grid.Row="1" Grid.Column="2" Width="38" Height="32" MinHeight="32" CornerRadius="0" FontWeight="Bold"
                                    Click="TextScaleButton_Click" AutomationProperties.Name="Text scaling">
                                <TextBlock x:Name="TextScaleGlyph" Text="A" TextDecorations="Underline"/>
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Number0" Modifiers="Control" Invoked="ResetTextScale_Invoked"/>
                                </Button.KeyboardAccelerators>
                            </Button>
                    </Grid>

                </Grid>
            </Grid>
        </Border>

        <!-- SCROLLABLE DASHBOARD -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20,18,20,14" MinWidth="1180">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="520"/>
                </Grid.RowDefinitions>

                <!-- SYSTEM & TUNING TOOLS -->
                <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Padding="22,14,22,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="SYSTEM &amp; TUNING TOOLS" FontWeight="Bold" FontSize="14"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <Button x:Name="TaskStatusButton" Content="Task Monitoring" MinWidth="156" Height="32" MinHeight="32"
                                        Style="{StaticResource ToolButtonStyle}" Margin="0"
                                        Click="TaskStatusButton_Click"
                                        AutomationProperties.Name="Task Monitoring"/>
                                <Button x:Name="RebootButton" Content="Reboot" Width="92" Height="32" MinHeight="32"
                                        Click="RebootButton_Click"
                                        Style="{StaticResource DangerToolButtonStyle}" Margin="0"/>
                                <Button Content="Exit" Width="92" Height="32" MinHeight="32"
                                        Click="ExitButton_Click"
                                        Style="{StaticResource ToolButtonStyle}" Margin="0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="REPAIR" FontSize="12" FontWeight="Bold" Margin="3,0,0,8"/>
                                <Button x:Name="FullRepairButton" Content="Full Repair"
                                        Click="FullRepairButton_Click"
                                        Style="{StaticResource PrimaryToolButtonStyle}"/>
                                <Button x:Name="QuickRepairButton" Content="Quick Repair"
                                        Click="QuickRepairButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
                                <Button x:Name="WindowsUpdateFixButton" Content="Windows Update Fix"
                                        Click="WindowsUpdateFixButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
                                <Button x:Name="MicrosoftStoreFixButton" Content="Microsoft Store Fix"
                                        Click="MicrosoftStoreFixButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="SYSTEM" FontSize="12" FontWeight="Bold" Margin="3,0,0,8"/>
                                <Button x:Name="ExplorerFixButton" Content="Explorer Fix"
                                        Click="ExplorerFixButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
                                <Button x:Name="DiskInfoButton" Content="Disk Info"
                                        Click="DiskInfoButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
                                <Button x:Name="SystemReportButton" Content="System Report"
                                        Click="SystemReportButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
                                <Button x:Name="WindowsActivationButton" Content="Windows Activation"
                                        Click="WindowsActivationButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
                                <Button x:Name="OfficeActivationButton" Content="Office Activation"
                                        Click="OfficeActivationButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SECURITY" FontSize="12" FontWeight="Bold" Margin="3,0,0,8"/>
                                <Button x:Name="DisableDefenderButton" Content="Disable Defender"
                                        Click="DisableDefenderButton_Click"
                                        Style="{StaticResource DangerToolButtonStyle}"/>
                                <Button x:Name="RestoreDefenderButton" Content="Restore Defender"
                                        Click="RestoreDefenderButton_Click"
                                        Style="{StaticResource SuccessToolButtonStyle}"/>
                                <Button x:Name="BitLockerManagerButton" Content="BitLocker Manager"
                                        Click="BitLockerManagerButton_Click"
                                        Style="{StaticResource WarningToolButtonStyle}"/>
                                <Button x:Name="SmartAppControlButton" Content="Smart App Control"
                                        Click="SmartAppControlButton_Click"
                                        Style="{StaticResource WarningToolButtonStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="ADVANCED" FontSize="12" FontWeight="Bold" Margin="3,0,0,8"/>
                                <Button x:Name="EssentialTweaksButton" Content="Essential Windows Tweaks"
                                        Click="EssentialTweaksButton_Click"
                                        Style="{StaticResource PrimaryToolButtonStyle}"/>
                                <Button x:Name="GamingTweaksButton" Content="Gaming Tweaks"
                                        Click="GamingTweaksButton_Click"
                                        Style="{StaticResource PrimaryToolButtonStyle}"/>
                                <Button x:Name="RuntimeCompatibilityButton" Content="Games Runtime &amp; Compatibility Check"
                                        Click="RuntimeCompatibilityButton_Click"
                                        Style="{StaticResource PrimaryToolButtonStyle}"/>
                                <Button x:Name="GpuDriverManagerButton" Content="GPU Driver Manager"
                                        Click="GpuDriverManagerButton_Click"
                                        Style="{StaticResource PrimaryToolButtonStyle}"/>
                                <Button x:Name="DebloatButton" Content="Advanced Windows Tweaks &amp; De-Bloat"
                                        Click="DebloatButton_Click"
                                        Style="{StaticResource WarningToolButtonStyle}"/>
                                <Button x:Name="MsiModeUtilityButton" Content="MSI Mode Utility"
                                        Click="MsiModeUtilityButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
                                <Button x:Name="LegacyWindowsPanelsButton" Content="Legacy Windows Panels"
                                        Click="LegacyWindowsPanelsButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- LOWER DASHBOARD -->
                <Grid Grid.Row="2" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="510"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- PERFORMANCE PROFILE -->
                    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Padding="18,16">
                        <StackPanel Spacing="14">
                            <TextBlock Text="PERFORMANCE PROFILE" FontWeight="Bold" FontSize="14"/>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="CompetitiveProfileButton" Grid.Column="0"
                                        Content="Competitive Gaming" Tag="Competitive Gaming"
                                        Click="ProfileSelectionButton_Click"
                                        Style="{StaticResource ToolButtonStyle}" Margin="0"/>
                                <Button x:Name="OptimizedProfileButton" Grid.Column="1"
                                        Content="Optimized Gaming" Tag="Optimized Gaming"
                                        Click="ProfileSelectionButton_Click"
                                        Style="{StaticResource ToolButtonStyle}" Margin="0"/>
                                <Button x:Name="BalancedProfileButton" Grid.Column="2"
                                        Content="Balanced" Tag="Balanced"
                                        Click="ProfileSelectionButton_Click"
                                        Style="{StaticResource ToolButtonStyle}" Margin="0"/>
                            </Grid>

                            <Button x:Name="ApplyProfileButton" Content="SELECT A PROFILE" Height="34"
                                    Click="ApplyProfileButton_Click" IsEnabled="False"
                                    Style="{StaticResource ToolButtonStyle}" Margin="0"/>

                            <Border Background="#EDF2F8" BorderBrush="#7F8C9D" BorderThickness="1" Padding="14,12" Height="88">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="CURRENT PROFILE" FontSize="11" Foreground="#33465F"/>
                                    <TextBlock x:Name="CurrentProfileValueText" Text="Initializing..." FontSize="16" FontWeight="Bold"
                                               Foreground="#C15B00"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Applies the complete selected profile: MMCSS, processor power policy, BCD/timer, TCP/QoS and RSC. Competitive and Optimized Gaming use Ultimate Performance; Balanced uses the Windows Balanced plan."
                                       FontSize="12" Foreground="#33465F" TextWrapping="Wrap"/>

                            <TextBlock Text="Every apply operation requires confirmation and Administrator rights. Game DVR remains independently controlled from Gaming Tweaks. Restart Windows after a profile change."
                                       FontSize="12" Foreground="#33465F" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- LIVE GAMING STATUS -->
                    <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}" Padding="16">
                        <Grid RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔴 LIVE GAMING STATUS" FontSize="14" FontWeight="Bold"/>
                                <TextBlock x:Name="UpdatedText" Grid.Column="1" Text="Updated 00:00:00"
                                           FontSize="11" Foreground="#315486"/>
                            </Grid>

                            <Grid Grid.Row="1" ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="CPU LIVE" FontSize="10"/>
                                        <TextBlock x:Name="CpuValueText" Text="Initializing..." Foreground="#008A3C" FontSize="14"/>
                                        <Grid x:Name="CpuGraphHost"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="RAM LIVE" FontSize="10"/>
                                        <TextBlock x:Name="RamValueText" Text="Initializing..." Foreground="#008A3C" FontSize="14"/>
                                        <Grid x:Name="RamGraphHost"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="GPU 3D LIVE" FontSize="10"/>
                                        <TextBlock x:Name="GpuValueText" Text="Pending" Foreground="#315486" FontSize="14"/>
                                        <Grid x:Name="GpuGraphHost"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="NETWORK RX / TX" FontSize="10"/>
                                        <TextBlock x:Name="NetworkValueText" Text="Initializing..." Foreground="#008A3C" FontSize="14"/>
                                        <Grid x:Name="NetworkGraphHost"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="PROCESSES" FontSize="10"/>
                                        <TextBlock x:Name="ProcessValueText" Text="--" FontSize="14"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="POWER PLAN" FontSize="10"/>
                                        <TextBlock x:Name="PowerPlanValueText" Text="Initializing..." Foreground="#005FB8" FontSize="14"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="MMCSS" FontSize="10"/>
                                        <TextBlock x:Name="MmcssValueText" Text="Initializing..." Foreground="#C15B00" FontSize="14"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="GAME MODE" FontSize="10"/>
                                        <TextBlock x:Name="GameModeValueText" Text="Initializing..." Foreground="#C15B00" FontSize="14"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="HAGS" FontSize="10"/>
                                        <TextBlock x:Name="HagsValueText" Text="Initializing..." Foreground="#315486" FontSize="14"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="UPTIME" FontSize="10"/>
                                        <TextBlock x:Name="UptimeValueText" Text="--" FontSize="14"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBox x:Name="LiveDetailText" Grid.Row="2"
                                     Text="STATUS: Initializing..."
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Background="#07111F"
                                     Foreground="#F5F7FA"
                                     BorderThickness="0"
                                     Padding="10"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
