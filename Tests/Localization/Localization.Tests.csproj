<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\UiTranslationCatalog.cs" Link="UiTranslationCatalog.cs" />
    <Compile Include="..\..\UiTranslation.cs" Link="UiTranslation.cs" />
    <Compile Include="..\..\NativeUiCatalog*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="..\..\UiLocalizedValue.cs" Link="UiLocalizedValue.cs" />
    <Compile Include="..\..\UiLocalizationLifetime.cs" Link="UiLocalizationLifetime.cs" />
    <Compile Include="..\..\UiTranslationTemplates.cs" Link="UiTranslationTemplates.cs" />
    <Compile Include="..\..\SupplementalUiCatalog.cs" Link="SupplementalUiCatalog.cs" />
    <Compile Include="..\..\CatalogDisplayNames.cs" Link="CatalogDisplayNames.cs" />
    <Compile Include="..\..\UiTextKeys.cs" Link="UiTextKeys.cs" />
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(MSBuildSDKsPath)\..\Roslyn\bincore\Microsoft.CodeAnalysis.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(MSBuildSDKsPath)\..\Roslyn\bincore\Microsoft.CodeAnalysis.CSharp.dll</HintPath></Reference>
  </ItemGroup>
</Project>
